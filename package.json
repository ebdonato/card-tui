{
    "name": "ebdonato",
    "version": "10.1.0",
    "description": "Eduardo Batista Donato - CLI Card & Resume",
    "keywords": [
        "cli",
        "tui",
        "donato",
        "card",
        "resume",
        "business-card",
        "terminal",
        "npx",
        "interactive",
        "developer"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/ebdonato/card-tui"
    },
    "main": "bin/index.js",
    "bin": {
        "ebdonato": "./bin/index.js"
    },
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "start": "node bin/index.js",
        "build": "node build-cv.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "boxen": "^9.0.0",
        "chalk": "^6.0.1",
        "inquirer": "^14.3.0",
        "marked": "^18.2.0",
        "marked-terminal": "^7.3.1",
        "open": "^11.0.4",
        "qrcode-terminal": "^0.12.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "globals": "^17.14.0",
        "prettier": "^3.10.1"
    }
}
